; Minimal MDP for genion .tpr preparation
; -----------------------------------------
title                   = Ions preparation

integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 0             ; Zero steps — only need .tpr structure

cutoff-scheme           = Verlet
nstlist                 = 1
rcoulomb                = 1.0
rvdw                    = 1.0
coulombtype             = PME
pbc                     = xyz
constraints             = none          ; No constraints needed for single-point